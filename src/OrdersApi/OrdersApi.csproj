<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AWSProjectType>Lambda</AWSProjectType>
    <!-- Assembly name doubles as the Lambda handler for the .NET 8 managed runtime.
         Keep in sync with infra/Program.cs (HandlerAssembly = "OrdersApi"). -->
    <AssemblyName>OrdersApi</AssemblyName>
    <RootNamespace>OrdersApi</RootNamespace>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="1.7.0" />
  </ItemGroup>

</Project>
